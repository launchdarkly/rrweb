{
  "name": "@highlight-run/rrweb-replay",
  "version": "2.0.0-lambda.5",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "devtools",
    "product-analytics",
    "real-user-monitoring",
    "rrweb",
    "@rrweb/replay"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check-types": "tsc -noEmit",
    "prepublish": "tsc -noEmit && vite build",
    "lint": "npx eslint src/**/*.ts",
    "test:update": "vitest run -u"
  },
  "homepage": "https://github.com/rrweb-io/rrweb/tree/main/packages/@rrweb/replay#readme",
  "bugs": {
    "url": "https://github.com/rrweb-io/rrweb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrweb-io/rrweb.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/rrweb-replay.cjs",
  "module": "./dist/rrweb-replay.js",
  "unpkg": "./dist/rrweb-replay.umd.cjs",
  "jsdelivr": "./umd/rrweb-replay.js",
  "style": "./dist/style.css",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rrweb-replay.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/rrweb-replay.cjs"
      }
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "umd",
    "dist",
    "package.json"
  ],
  "devDependencies": {
    "puppeteer": "^20.9.0",
    "typescript": "^5.4.5",
    "vite": "^6.4.2",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@highlight-run/rrweb": "workspace:*",
    "@highlight-run/rrweb-types": "workspace:*"
  },
  "browserslist": [
    "supports es6-class"
  ]
}
