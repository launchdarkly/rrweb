{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "esModuleInterop": true,
    "incremental": true,
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["src/*"],
      "rrweb": [
        "../../../node_modules/@highlight-run/rrweb",
        "../../node_modules/@highlight-run/rrweb"
      ],
      "rrweb-player": [
        "../../../node_modules/@highlight-run/rrweb-player",
        "../../node_modules/@highlight-run/rrweb-player"
      ],
      "@rrweb/types": [
        "../../../node_modules/@highlight-run/rrweb-types",
        "../../node_modules/@highlight-run/rrweb-types"
      ]
    },
    "jsx": "react-jsx"
  },
  "exclude": ["dist", "node_modules", "vite.config.ts"],
  "references": [
    {
      "path": "../rrweb"
    },
    {
      "path": "../rrweb-player"
    },
    {
      "path": "../types"
    }
  ]
}
